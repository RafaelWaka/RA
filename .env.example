# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin dashboard auth (MVP: single shared password, see src/middleware.ts) ---
# Change this before deploying. Use a long random string.
ADMIN_PASSWORD=change-me

# --- Cron protection (Vercel Cron sends this as a Bearer token, see vercel.json) ---
CRON_SECRET=change-me-too

# --- Analytics (optional, wire in src/app/layout.tsx) ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_ID=

# --- Newsletter provider (optional, wire in src/lib/newsletter.ts) ---
# e.g. Resend, Brevo, Mailchimp, ConvertKit...
NEWSLETTER_API_KEY=
NEWSLETTER_LIST_ID=

# --- Editorial automation (optional, wire in src/lib/ai/*) ---
# Web search / news retrieval provider used in Step 1 (recherche automatique).
SEARCH_API_KEY=
# LLM provider used in Step 2 (idées) and Step 4 (rédaction).
# The codebase is provider-agnostic: see src/lib/ai/generateIdeas.ts and
# src/lib/ai/generateArticleDraft.ts for the exact swap-in points.
ANTHROPIC_API_KEY=

# --- Database (optional, once you outgrow the JSON file store) ---
# e.g. Vercel Postgres / Supabase / Neon connection string.
# See src/lib/store.ts for the adapter interface to implement.
DATABASE_URL=
