# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin dashboard auth (MVP: single shared password, see src/middleware.ts) ---
# Change this before deploying. Use a long random string.
ADMIN_PASSWORD=change-me

# --- Cron protection (Vercel Cron sends this as a Bearer token, see vercel.json) ---
CRON_SECRET=change-me-too

# --- Store du workflow éditorial (idées, brouillons, newsletter, contact) ---
# Requis en production sur Vercel (voir src/lib/editorial/store.ts) : le
# système de fichiers des fonctions serverless est en lecture seule.
# Dans le dashboard Vercel du projet : Storage -> Add -> "Upstash for Redis"
# (Marketplace). Vercel injecte automatiquement ces deux variables, aucune
# autre configuration nécessaire.
# En local, si elles sont absentes, un store fichier (data/*.json) est
# utilisé à la place.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Publication (écriture des articles validés dans le dépôt GitHub) ---
# Requis en production pour que le bouton "Publier" de /admin/brouillons
# fonctionne (voir src/lib/github.ts). Créez un Personal Access Token
# fine-grained sur https://github.com/settings/personal-access-tokens/new,
# limité à ce dépôt, avec la permission "Contents: Read and write".
# Nommé PUBLISH_GITHUB_TOKEN (pas GITHUB_TOKEN) pour éviter toute collision
# avec un token déjà présent dans l'environnement (CI, autre outil...).
PUBLISH_GITHUB_TOKEN=
GITHUB_OWNER=RafaelWaka
GITHUB_REPO=RA
GITHUB_BRANCH=claude/recruteur-demain-media-wvv51r

# --- Analytics (optional, wire in src/app/layout.tsx) ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_ID=

# --- Newsletter provider (optional, wire in src/lib/newsletter.ts) ---
# e.g. Resend, Brevo, Mailchimp, ConvertKit...
NEWSLETTER_API_KEY=
NEWSLETTER_LIST_ID=

# --- Editorial automation (optional, wire in src/lib/editorial/*) ---
# Web search / news retrieval provider used in Step 1 (recherche automatique).
SEARCH_API_KEY=
# LLM provider used in Step 2 (idées) and Step 4 (rédaction).
# The codebase is provider-agnostic: see src/lib/editorial/generate-ideas.ts
# and src/lib/editorial/generate-draft.ts for the exact swap-in points.
ANTHROPIC_API_KEY=
